# Inspect local development (native Windows — no Docker)
# Copy to .env and fill secrets. Never commit .env.

NODE_ENV=development
APP_NAME=Inspect
APP_VERSION=0.0.1

API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=log

# MySQL / MariaDB (compatible). Local discovery used MariaDB 10.11 on 127.0.0.1:3306.
# Create dedicated DB/user with: .\scripts\create-inspect-mysql.ps1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=inspect_app
MYSQL_PASSWORD=replace_with_inspect_app_password
MYSQL_DATABASE=inspect
DATABASE_URL=mysql://inspect_app:replace_with_inspect_app_password@127.0.0.1:3306/inspect

# Background jobs (NestJS Scheduler + MySQL background_jobs table)
JOB_POLL_INTERVAL_MS=1000
JOB_LEASE_SECONDS=30
JOB_DIAGNOSTIC_RETENTION_HOURS=24

HEALTH_CHECK_TIMEOUT_MS=2000
VITE_API_BASE_URL=http://localhost:3001

# Authentication (opaque cookie sessions; Milestone 2 Phase 1)
# Session lifetime in seconds (default 14 days)
SESSION_TTL_SECONDS=1209600
# Secure cookie flag: defaults to true when NODE_ENV=production (cannot be false in production)
# COOKIE_SECURE=false
# SameSite attribute: lax (default), strict, or none (none requires Secure and forces Origin checks)
COOKIE_SAME_SITE=lax
# Require Origin on auth mutations: default true in production / SameSite=none; optional override
# AUTH_REQUIRE_ORIGIN=true
# Login/register rate limit (per direct peer IP; in-memory per process — not for multi-instance alone)
AUTH_SENSITIVE_RATE_LIMIT=10
AUTH_SENSITIVE_RATE_TTL_MS=60000
