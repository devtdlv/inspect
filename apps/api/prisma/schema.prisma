generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Authenticated application user (email + Argon2id password hash).
model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(320)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  sessions     Session[]

  @@map("users")
}

/// Opaque server-side session. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

/// Foundation metadata store for application-level key/value records.
/// Domain models (monitors, incidents) arrive in later milestones.
model AppMeta {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(191)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_meta")
}

enum JobStatus {
  pending
  processing
  completed
  failed
}

/// Durable MySQL-backed background jobs (NestJS Scheduler workers claim rows).
/// Execution is at-least-once; handlers must be idempotent.
model BackgroundJob {
  id          String    @id @default(cuid())
  type        String    @db.VarChar(100)
  payload     Json
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  lockedBy    String?   @map("locked_by") @db.VarChar(100)
  lockedUntil DateTime? @map("locked_until")
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([status, runAt], map: "background_jobs_status_run_at_idx")
  @@index([lockedUntil], map: "background_jobs_locked_until_idx")
  @@index([type, status], map: "background_jobs_type_status_idx")
  @@map("background_jobs")
}
